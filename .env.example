# ─────────────────────────────────────────────────
# LOCAL DEV — copy this file to .env.local
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────

# Set your admin password here (choose something strong!)
NEXT_PUBLIC_ADMIN_PASSWORD=your_strong_password_here

# Photo URL - Use a persistent Vercel Blob or cloud storage URL
# Examples:
# - Vercel Blob: https://blob.vercel-storage.com/your-key
# - Cloudinary: https://res.cloudinary.com/your-cloud/image/upload/your-photo.jpg
# - Unsplash: https://images.unsplash.com/photo-xxxxx?w=400&h=400&fit=crop
NEXT_PUBLIC_DEFAULT_PHOTO_URL=https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop
